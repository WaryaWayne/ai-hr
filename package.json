{
  "name": "ai-hr",
  "version": "0.0.5",
  "description": "Local AI employee performance reviews for coding agents, with usage scans, API-equivalent cost estimates, and terminal report cards.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaryaWayne/ai-hr.git"
  },
  "bugs": {
    "url": "https://github.com/WaryaWayne/ai-hr/issues"
  },
  "homepage": "https://github.com/WaryaWayne/ai-hr",
  "bin": {
    "ai-hr": "dist/cli.js",
    "aihr": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "rolldown packages/cli/src/Main.ts --platform node --format esm --file dist/cli.js",
    "cli": "pnpm build && node dist/cli.js",
    "publish:npm": "pnpm build && npm publish --access public --ignore-scripts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && vitest run",
    "prepare": "effect-language-service patch"
  },
  "keywords": [
    "ai-hr",
    "aihr",
    "codex",
    "claude-code",
    "opencode",
    "coding-agents",
    "cli",
    "local-first",
    "token-usage",
    "api-cost-estimates",
    "usage-report",
    "effect",
    "node"
  ],
  "author": "Warya Wayne",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.5.0",
  "devDependencies": {
    "@effect/language-service": "^0.86.1",
    "@effect/vitest": "4.0.0-beta.74",
    "@effect/sql-pg": "4.0.0-beta.74",
    "@types/node": "^25.6.2",
    "rolldown": "1.0.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.15",
    "@effect/platform-node": "4.0.0-beta.74",
    "@openai/codex-sdk": "^0.135.0",
    "@opencode-ai/sdk": "^1.15.12",
    "effect": "4.0.0-beta.74"
  }
}
